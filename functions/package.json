{
  "name": "gdgsucre-events-functions",
  "private": true,
  "version": "1.0.0",
  "description": "Cloud Functions v2 backend for GDG SPIN and event interactions.",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test scripts",
    "test:unit": "vitest run test/unit",
    "test:rules": "vitest run test/rules.test.ts",
    "test:emulator": "vitest run test/emulator",
    "test": "vitest run",
    "bootstrap": "tsx scripts/bootstrap-spin.ts"
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.15.0",
    "eslint": "^10.15.0",
    "firebase": "^12.19.0",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
