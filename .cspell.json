{
    "version": "0.2",
    "language": "en",
    "files": [
        "lib/**/*.dart",
        "test/**/*.dart"
    ],
    "ignorePaths": [
        "lib/config/theme/app_strings.dart",
        "lib/env.dart",
        "lib/firebase_options.dart",
        "test/coverage_helper_test.dart"
    ],
    "patterns": [
        {
            "name": "AssetPath",
            "pattern": "/['\"]assets\\/[^'\"]*['\"]/g"
        }
    ],
    "ignoreRegExpList": [
        "AssetPath"
    ],
    "dictionaryDefinitions": [
        {
            "name": "project-words",
            "path": "./.cspell/project-words.txt",
            "addWords": true
        }
    ],
    "dictionaries": [
        "project-words"
    ]
}
